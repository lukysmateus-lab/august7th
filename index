                        <p class="text-gray-900 font-black text-lg mb-2">Graded Activity</p>
                        <p class="text-gray-700 font-medium leading-relaxed">Please complete <strong class="bg-blue-200/50 px-1 rounded text-blue-800">Graded Activity 3</strong> before the next class.</p>
                    </div>
                </div>
            </section>
        </div>

    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Timer Logic (32 min class)
            let minutes = 32;
            let seconds = 0;
            const timerDisplay = document.getElementById('class-timer');
            
            if (timerDisplay) {
                setInterval(() => {
                    if(seconds === 0 && minutes > 0) {
                        minutes--;
                        seconds = 59;
                    } else if (seconds > 0) {
                        seconds--;
                    }
                    
                    const mins = minutes.toString().padStart(2, '0');
                    const secs = seconds.toString().padStart(2, '0');
                    timerDisplay.textContent = `${mins}:${secs}`;
                    
                    if(minutes < 5) {
                        timerDisplay.parentElement.classList.add('bg-red-50', 'border-red-200');
                        timerDisplay.classList.add('text-red-600');
                        timerDisplay.previousElementSibling.classList.add('text-red-500');
                    }
                }, 1000);
            }

            // Custom Audio Player Logic
            const audio = document.getElementById('pocket-audio');
            const playBtn = document.getElementById('play-btn');
            const playIcon = document.getElementById('play-icon');
            const seekSlider = document.getElementById('seek-slider');
            const currentTimeContainer = document.getElementById('current-time');
            const durationContainer = document.getElementById('duration');

            // Format time helper
            const calculateTime = (secs) => {
                const minutes = Math.floor(secs / 60);
                const seconds = Math.floor(secs % 60);
                const returnedSeconds = seconds < 10 ? `0${seconds}` : `${seconds}`;
                return `${minutes}:${returnedSeconds}`;
            }

            const displayDuration = () => {
                durationContainer.textContent = calculateTime(audio.duration);
                seekSlider.max = Math.floor(audio.duration);
            }

            // Play / Pause
            playBtn.addEventListener('click', () => {
                if(audio.paused) {
                    audio.play();
                    playIcon.classList.remove('fa-play');
                    playIcon.classList.remove('ml-1');
                    playIcon.classList.add('fa-pause');
                } else {
                    audio.pause();
                    playIcon.classList.remove('fa-pause');
                    playIcon.classList.add('fa-play');
                    playIcon.classList.add('ml-1');
                }
            });

            // Update duration when metadata loads
            if (audio.readyState > 0) {
                displayDuration();
            } else {
                audio.addEventListener('loadedmetadata', displayDuration);
            }

            // Update slider and current time as audio plays
            audio.addEventListener('timeupdate', () => {
                seekSlider.value = Math.floor(audio.currentTime);
                currentTimeContainer.textContent = calculateTime(seekSlider.value);
            });

            // Handle slider drag
            seekSlider.addEventListener('input', () => {
                currentTimeContainer.textContent = calculateTime(seekSlider.value);
            });

            seekSlider.addEventListener('change', () => {
                audio.currentTime = seekSlider.value;
            });

            // Reset when audio ends
            audio.addEventListener('ended', () => {
                playIcon.classList.remove('fa-pause');
                playIcon.classList.add('fa-play');
                playIcon.classList.add('ml-1');
                seekSlider.value = 0;
                currentTimeContainer.textContent = "0:00";
            });
        });

        // Validation for Text Inputs
        function checkInput(inputElement) {
            const correctVals = inputElement.getAttribute('data-correct').split(',');
            const userVal = inputElement.value.trim().toLowerCase().replace(/\s+/g, ' '); 
            
            inputElement.classList.remove('val-correct', 'val-incorrect');
            if (userVal === '') return;

            let isCorrect = correctVals.some(val => val.trim().toLowerCase() === userVal);
            if (isCorrect) {
                inputElement.classList.add('val-correct');
            } else {
                inputElement.classList.add('val-incorrect');
            }
        }
    </script>
</body>
</html>
